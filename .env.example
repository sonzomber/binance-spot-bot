# ============================================================
#  Binance Spot Bot — configuración
#  Copia este archivo como .env y completa tus valores:
#      cp .env.example .env
#  NUNCA subas el .env a git (ya está en .gitignore).
# ============================================================

# --- Entorno ------------------------------------------------
# testnet → Spot Testnet (https://testnet.binance.vision)   [por defecto]
# demo    → Demo Mode    (https://demo.binance.com)
# No existe opción para mainnet: con cualquier otro valor el bot no arranca.
BINANCE_ENV=testnet

# API keys DEL ENTORNO ELEGIDO (las de testnet no sirven en demo, y viceversa).
# Opcionales en dry-run: sin keys el bot usa solo datos públicos.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Modo de ejecución --------------------------------------
# true  → simula las órdenes (con comisión y slippage), no envía nada   [por defecto]
# false → envía órdenes al testnet/demo (fondos ficticios). Hay que escribir
#         exactamente "false": 0, no u off son un error. Al arrancar se muestra
#         una advertencia y hay 5 s para cancelar con Ctrl+C.
DRY_RUN=true

# --- Mercado ------------------------------------------------
# Par en formato BASE/USDT
SYMBOL=BTC/USDT
# Duración de cada vela: 1m 3m 5m 15m 30m 1h 2h 4h 6h 8h 12h 1d
TIMEFRAME=15m
# Cómo recibir velas nuevas: rest (consulta periódica) | ws (WebSocket)
DATA_FEED=rest
# Segundos sin datos nuevos para considerarlos desactualizados (se bloquean órdenes)
DATA_STALE_AFTER_SECONDS=60

# --- Estrategia ---------------------------------------------
# Estrategia activa (OBLIGATORIA). Si falta o no existe, el bot no arranca.
# Disponibles: las de src/strategy/strategies/ (por ahora: sma-cross)
STRATEGY=sma-cross
# Parámetros de la estrategia en JSON (una sola línea). Los que no pongas
# usan su valor por defecto. sma-cross: fast (SMA rápida), slow (SMA lenta)
STRATEGY_PARAMS={"fast":9,"slow":21}

# --- Gestión de riesgo --------------------------------------
# Monto máximo (en USDT) por operación
MAX_TRADE_USDT=50
# Pérdida máxima diaria (en USDT, neta de comisiones). El "día" es el día UTC
# (00:00 a 23:59:59 UTC). Al alcanzarla, el bot se detiene y requiere `npm run resume`.
MAX_DAILY_LOSS_USDT=20
# Máximo de posiciones abiertas a la vez
MAX_OPEN_POSITIONS=1
# Si este archivo existe, el bot se detiene de forma segura (npm run kill lo crea).
# Reanudar requiere `npm run resume`.
KILL_SWITCH_FILE=./STOP

# --- Simulación (dry-run y backtest) ------------------------
# Comisión por operación (0.001 = 0.1%, la estándar de Binance Spot)
FEE_RATE=0.001
# Slippage estimado en puntos básicos (5 bps = 0.05%)
SLIPPAGE_BPS=5

# --- Logs y almacenamiento ----------------------------------
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
LOG_FILE=./data/logs/bot.log
DB_PATH=./data/bot.db
