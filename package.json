{
  "name": "binance-spot-bot",
  "version": "0.1.0",
  "description": "Bot de trading educativo para Binance Spot (solo testnet/demo, nunca mainnet)",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "kill": "node scripts/kill.js",
    "resume": "node scripts/resume.js",
    "status": "node scripts/status.js",
    "feed": "node scripts/feed.js",
    "reconcile": "node scripts/reconcile.js",
    "backtest": "node scripts/backtest.js",
    "panel": "vite build --config panel/web/vite.config.js --logLevel warn && node scripts/panel.js",
    "panel:build": "vite build --config panel/web/vite.config.js",
    "panel:dev": "node scripts/panel.js --dev",
    "launcher": "node launcher/cli.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "ccxt": "^4.5.84",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pm2": "^7.0.4",
    "ws": "^8.21.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "lightweight-charts": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "pm2": {
      "js-yaml": "4.3.2"
    }
  }
}
